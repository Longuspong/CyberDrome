  "story": [
    {"thema": "Grundidee", "text": "Dystopie: Roboter und Aufrüstung von Menschen halfen der Gesellschaft lange. Dann übernimmt ein Cybervirus, der sich vermehrt und anpasst, die Roboter. Ein Systemneustart hilft nicht.", "status": "Leitfaden 14. Nov."},
    {"thema": "Dilemma", "text": "Die einzige Waffe gegen Roboter sind wieder Roboter. Jede DROME kann selbst infiziert werden -- jeder Sieg hat seinen Preis.", "status": "Leitfaden 14. Nov."},
    {"thema": "Name", "text": "CyberDrome = Setting und Einheiten. DROME = Death Robot Omni Machine Executor (mit M, nicht Drone).", "status": "Leitfaden 14. Nov."},
    {"thema": "Erzählperspektive", "text": "Keine personifizierte Hauptfigur, der Spieler ist kein Commander und spricht kaum. Beobachtende Sicht: das Tutorial wirkt wie ein Video. Erzählt wird über Commander und Fraktionsoberhäupter und über Missverständnisse, die sich aufklären. Nach dem ersten großen Twist: vom Zuschauer zu 'Ich gehöre zum Team'.", "status": "Leitfaden 14. Nov."},
    {"thema": "Geheimer Twist", "text": "Hängt mit der fehlenden Hauptfigur zusammen. Bewusst noch nicht festgehalten.", "status": "offen"},
    {"thema": "Struktur der Welt", "text": "Wie Everspace 2: wirkt wie ein Krieg der Fraktionen, dahinter ein Drahtzieher; ein Gegenspieler verbindet die Einsichtigen. Regionen werden freigeschaltet, man springt zwischen ihnen. Schwierigkeit je Region in einem Rahmen, kein steiler Anstieg.", "status": "Leitfaden 14. Nov."},
    {"thema": "Prolog / Tutorial", "text": "„Die Welt, wie sie war“: video-artiger Einstieg, Roboter als Fortschritt zeigen, damit der Verlust wehtut. Erste Störungen wirken wie Pannen.", "status": "Leitfaden 14. Nov."},
    {"thema": "Akt 1", "text": "„Der vergiftete Brunnen“: Unfälle gehen immer mit Ressourcentransfers einher, die Fraktionen verdächtigen sich gegenseitig. Neon Ninja's blocken Hinweise ab, Solar Sentients werden über ihre Vernetzung getroffen. Leitfrage: Wer sabotiert hier wen?", "status": "Leitfaden 14. Nov."},
    {"thema": "Wendepunkt 1", "text": "„Selbst die Starken fallen“: die Mega Mechas brechen trotz Abkehr von Energietechnik zusammen. Leitfrage: Ist das überhaupt ein Krieg zwischen Fraktionen?", "status": "Leitfaden 14. Nov."},
    {"thema": "Wendepunkt 2", "text": "„Im Rauschen versteckt“: bei den Hipstar Hackers wird aufgedeckt, dass es ein Virus ist -- die Exploit-Experten haben ihn als Letzte bemerkt.", "status": "Leitfaden 14. Nov."},
    {"thema": "Akt 2", "text": "„Der Sondertrupp“: Einsichtige aus allen Fraktionen schließen sich ohne Fraktionsbindung zusammen, verbunden vom Gegenspieler. Fraktionsübergreifende Teams werden Kern des Spiels.", "status": "Leitfaden 14. Nov."},
    {"thema": "Akt 3", "text": "„Der Preis der Waffe“: je stärker die DROMEs, desto größer das Infektionsrisiko. Auflösung des geheimen Twists.", "status": "Leitfaden 14. Nov."},
    {"thema": "Fraktionsvarianten", "text": "Standard-DROMEs (Molok Tank, Vireo Allrounder, Nimbus, Strix) sind die ersten Militärformen. Fraktionsvarianten füllen Nischen. Fest: Solar-Molok teilt sich in zwei DROMEs, die sich wieder zusammensetzen können; Neon-Vireo mit mehr Energieschaden und Schild. Der Sondertrupp spiegelt das gemischte Team des Spielers.", "status": "Leitfaden 14. Nov."},
    {"thema": "Infinity-Einsatz", "text": "Story-Einbettung offen (früher: Chaos-Netz unter der Stadt).", "status": "offen"}
  ],

