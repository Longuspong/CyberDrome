# Exportierte Bots -- Arbeitsergebnisse der Werkstatt, kein Quellmaterial.
# Ein Build, der ins Spiel soll, wird bewusst mit -f hinzugefuegt.
builds/*
!builds/.gitkeep

# Im Tool gespeicherte Farbpaletten (lokale Arbeitsstaende)
palettes.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Godot
.godot/
.import/
# export_presets.cfg ist versioniert: der Web-Export (PWA) baut in CI daraus.
# Er enthaelt keine Geheimnisse -- ein Android-Keystore gehoerte NICHT hinein.
build/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
